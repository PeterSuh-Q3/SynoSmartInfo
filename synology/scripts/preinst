#!/bin/sh

# Pre-installation script for Change Panel Size
echo "Pre-installation check starting..."

# Handle presets first (if any) - 오류가 발생해도 계속 진행
if [ -x "$(dirname $0)/_presets" ]; then
    "$(dirname $0)"/_presets $0 "$@" || echo "Presets script failed, continuing..."
fi

# 기본 권한 체크 - 더 관대하게 설정
if [ "$(id -u)" != "0" ]; then
    echo "Warning: This package works best with root privileges."
    # exit 1 대신 경고만 표시
fi

# 필요한 시스템 명령어들이 있는지 확인
MISSING_COMMANDS=""
for cmd in bash sh mkdir chmod ln; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        MISSING_COMMANDS="$MISSING_COMMANDS $cmd"
    fi
done

if [ -n "$MISSING_COMMANDS" ]; then
    echo "Warning: Some required commands are missing:$MISSING_COMMANDS"
    echo "Installation may fail. Please ensure these commands are available."
    # 경고만 표시하고 계속 진행
fi

# Check if running inside a virtual machine
if grep -qi 'hypervisor' /proc/cpuinfo; then
  echo "This package is not recommended for installation within a virtual machine environment. It does not provide S.M.A.R.T. information for virtual disks."
  # 경고만 표시하고 계속 진행
  # exit 1
fi

# 2.0.0-2.0.4 declared conf/privilege's own "sc-synosmartinfo" user /
# "synosmartinfo" group instead of DSM's auto-assigned package account.
# DSM never removes these on uninstall (they're OS-level accounts, not
# package files), and their mere presence breaks DSM's own auto-account
# resolution for THIS package's name ("Synosmartinfo" ends up bound to
# the leftover "synosmartinfo" group instead of getting its own) -
# every subsequent install/upgrade then fails with error 313 "failed to
# revise file attributes", fresh install included. Wipe them before DSM
# gets a chance to provision anything, on every install/upgrade path.
for cmd in synouser synogroup; do
    [ -x "/usr/syno/sbin/$cmd" ] || echo "Warning: /usr/syno/sbin/$cmd not found, skipping legacy account cleanup"
done
if [ -x /usr/syno/sbin/synouser ]; then
    /usr/syno/sbin/synouser --get sc-synosmartinfo >/dev/null 2>&1 && \
        { echo "Removing leftover sc-synosmartinfo account from a pre-2.0.5 install..."; /usr/syno/sbin/synouser --del sc-synosmartinfo || true; }
fi
if [ -x /usr/syno/sbin/synogroup ]; then
    /usr/syno/sbin/synogroup --get synosmartinfo >/dev/null 2>&1 && \
        { echo "Removing leftover synosmartinfo group from a pre-2.0.5 install..."; /usr/syno/sbin/synogroup --del synosmartinfo || true; }
fi

echo "Pre-installation check completed."
exit 0
